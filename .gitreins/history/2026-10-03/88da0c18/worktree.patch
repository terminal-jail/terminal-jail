+    expected = "exit 2, command not run, marker file ABSENT"
+    with tempfile.TemporaryDirectory(prefix="tj-parity-pproc-") as tmp:
+        root = pathlib.Path(tmp)
+        bindir = root / "bin"
+        bindir.mkdir()
+        # bwrap ABSENT from PATH; unshare present but its probe fails: the
+        # wrapper's auto backend resolves to unshare — the shape that used
+        # to silently expose the host /proc.

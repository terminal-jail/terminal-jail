+        stub.write_text("#!/bin/sh\nexit 1\n", encoding="utf-8")
+        stub.chmod(0o755)
+        marker = root / "marker-required"
+        env = dict(os.environ)
+        env.update(
+            {
+                "PATH": f"{bindir}:{os.defpath}",

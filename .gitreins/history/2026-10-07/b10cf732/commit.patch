+            "    def __init__(self, message, *, cause=''):\n"
+            "        super().__init__(message)\n"
+            "        self.cause = cause or message\n"
+            "\n"
+            "class LandlockUnsupportedError(LandlockError):\n"
+            "    pass\n"
+            "\n"

 # --- launch -------------------------------------------------------------------
 
+# The detailed degradation report remains available for operators who need
+# the diagnosis. Keep the default path to one line because this warning is
+# emitted by every auto-sandbox launch on hosts with the AppArmor restriction.
+_tj_fs_isolation_warning() {
+    local warning
+    warning="terminal-jail: WARNING: no filesystem isolation — could not create a uid mapping under the user namespace (no filesystem isolation: this host denies setuid inside unprivileged user namespaces, e.g. Ubuntu AppArmor profile 'unprivileged_userns'; see scripts/fs-isolation-probe.py)"
+    if [ "${TERMINAL_JAIL_VERBOSE_WARN:-0}" = "1" ]; then
+        # Preserve the complete warning text for verbose operators.
+        printf '%s\n' "$warning" >&2
+        printf '%s\n' \
+            "terminal-jail: fallback is the mapping-less PID namespace" \
+            "terminal-jail: identity environment scrubbing remains active" \
+            "terminal-jail: filesystem permissions are not isolated" \
+            "terminal-jail: the mapped launch was rejected by the host policy" \
+            "terminal-jail: the AppArmor profile blocks setuid in user namespaces" \
+            "terminal-jail: PID namespace containment remains enabled" \
+            "terminal-jail: the fallback does not claim DAC isolation" \
+            "terminal-jail: see scripts/fs-isolation-probe.py for classification" \
+            "terminal-jail: use --user for explicit hard-isolation behavior" \
+            "terminal-jail: set TERMINAL_JAIL_UID_MAP=0 for an explicit fallback" >&2
+    else
+        echo "terminal-jail: filesystem isolation degraded (AppArmor); set TERMINAL_JAIL_VERBOSE_WARN=1 for details" >&2
+    fi
+}
+
 # Read the subordinate-ID range start for a user from /etc/subuid or
 # /etc/subgid (first matching line). Prints 100000 when the file is absent,
 # unreadable, or has no entry for the user. The mapped launch is only ever
@@ -760,7 +787,7 @@ if [ "$USE_USER_NS" -eq 1 ]; then
                 if [ "$_tj_read_failed" -eq 1 ]; then
                     echo "terminal-jail: WARNING: seccomp loader not readable under the uid-mapped launch — falling back to a mapping-less --user launch (could not read '${SECCOMP_LOADER}' as the subordinate uid: a home/permission path such as a 0700 or 750 home is not traversable by it; PID-namespace containment and the seccomp filter still apply; remedy: place the loader under a traversable home, or set TERMINAL_JAIL_UID_MAP=0 to select this mode deliberately)" >&2
                 else
-                    echo "terminal-jail: WARNING: no filesystem isolation — could not create a uid mapping under the user namespace (no filesystem isolation: this host denies setuid inside unprivileged user namespaces, e.g. Ubuntu AppArmor profile 'unprivileged_userns'; see scripts/fs-isolation-probe.py)" >&2
+                    _tj_fs_isolation_warning
                 fi

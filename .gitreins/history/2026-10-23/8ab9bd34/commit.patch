    fix(tests): key the quickstart prose allowlist by token, not line
    
    DOC-15's rewording of docs/quickstart.md shifted the single prose
    placeholder (<the rule's block_message>) from computed line 334 to 361, so
    tests/test_quickstart_doc.py::test_prose_placeholders_are_allowlisted failed
    with "unallowlisted prose placeholders: [(361, ...)]" on a page whose prose
    was correct. A (line, token) table rots on every edit above the token.
    
    The allowlist is now a token set: an unlisted occurrence still fails, and an
    allowlisted token that no longer appears on the page still fails (both
    directions proven: an empty allowlist flags line 361, and an invented entry is
    reported stale). Found by the post-merge full-suite gate, not by the worker —
    the DOC-15 brief scoped it to the bridge tests.
    
    Co-authored-by: Alexis Okuwa <wojonstech@gmail.com>
---
 tests/test_quickstart_doc.py | 29 ++++++++++++-----------------
 1 file changed, 12 insertions(+), 17 deletions(-)

diff --git a/tests/test_quickstart_doc.py b/tests/test_quickstart_doc.py
index 546cd59..b7fbcc2 100644
--- a/tests/test_quickstart_doc.py
+++ b/tests/test_quickstart_doc.py
@@ -40,13 +40,14 @@ _PLACEHOLDER_RE = re.compile(r"<[a-z-]+>|\{[a-z_]+\}|YOUR_|<PATH>")
 # (``terminal-jail <command> [args...]``), output/JSON templates
 # (``<reason>``, ``[bridge-error] <detail>``), install-path patterns
 # (``<prefix>/lib/terminal-jail/``). Those are not paste targets, so every
-# occurrence is allowlisted by (1-based line number, exact token); an
-# unlisted occurrence fails, and so does a stale entry — the table cannot
-# rot silently. The single entry below pins the warn-reason template that
-# TJ-DF-042's doc-pin test requires verbatim.
+# occurrence is allowlisted by exact token; an unlisted occurrence fails, and
+# so does a stale entry — the table cannot rot silently. The single entry below
+# pins the warn-reason template that TJ-DF-042's doc-pin test requires verbatim.
+# Keyed by TOKEN, not by line: a (line, token) table rots on every prose edit
+# above the token (DOC-15's +32 lines broke it while the prose was correct).
 _PROSE_PLACEHOLDER_RE = re.compile(r"<[^<>\n]{1,60}>|\{[a-z_][a-z0-9_]*\}|YOUR_|<PATH>")
-_PROSE_PLACEHOLDER_ALLOWLIST: dict[int, set[str]] = {

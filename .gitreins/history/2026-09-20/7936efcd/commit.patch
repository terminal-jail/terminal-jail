 +
 +
 +# ── OK cases: clean/absent dirs (subprocess, hermetic) ──────────────────────
 +
 +
 +class TestOkCases:
 +    def test_absent_dirs_report_no_installed_override(self, tmp_path: Path) -> None:
 +        result = run_probe(
 +            env_extra={
 +                ENV_SYSTEM: str(tmp_path / "no-system"),

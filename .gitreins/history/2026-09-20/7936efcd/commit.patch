 +        user_dir = write_rules_dir(
 +            tmp_path / "user",
 +            {
 +                "00-builtins.yaml": downgraded_yaml(DOWNGRADED_ACTION),
 +                "10-tighten.yaml": downgraded_yaml("block").replace(
 +                    DOWNGRADED_ID, "auto-pytest"
 +                ).replace("sandbox\n", "block\n", 1),

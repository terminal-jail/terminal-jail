 +        )
 +        assert "DRIFT" in result.stdout
 +        assert result.returncode == 1
 +
 +    def test_action_changed_but_equal_strength_is_still_drift(
 +        self, tmp_path: Path
 +    ) -> None:
 +        # sandbox -> block is a TIGHTENING, not a downgrade: the row direction

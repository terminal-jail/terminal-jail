+# an aarch64 host.
 
 
 # Subset of deny syscalls that exist on *both* x86_64 and aarch64 with the
@@ -197,6 +228,7 @@ _DENY_EXTRA: Final[dict[str, frozenset[int]]] = {
             248,  # add_key
             249,  # request_key

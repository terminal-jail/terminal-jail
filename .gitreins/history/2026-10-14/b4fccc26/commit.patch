    polish(REVIEW-TJ-015): pin TERMINAL_JAIL_VERDICT_LOG=0 in the composed battery refusal arm
    
    Same full-repo-scope leak as the composed-mode test: the
    explicit-backend-no-downgrade arm in scripts/composed-mode-battery.py
    asserts the refusal stderr byte-identical, and the new per-verdict log
    line is diagnostic surface that must not pollute it.
    
    Co-authored-by: Alexis Okuwa <wojonstech@gmail.com>
---
 scripts/composed-mode-battery.py | 8 +++++++-
 tests/test_composed_mode.py      | 3 +++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/scripts/composed-mode-battery.py b/scripts/composed-mode-battery.py
index b963a41..c567355 100755
--- a/scripts/composed-mode-battery.py
+++ b/scripts/composed-mode-battery.py
@@ -215,7 +215,13 @@ def _inner_cell() -> dict:
         )
     try:
         result, _ = _cli_run(
-            ["echo", "x"], env_extra={"TERMINAL_JAIL_JAIL_BACKEND": "unshare"}
+            ["echo", "x"],
+            env_extra={
+                "TERMINAL_JAIL_JAIL_BACKEND": "unshare",
+                # REVIEW-TJ-015: the per-verdict stderr log is diagnostic
+                # surface; this arm asserts the refusal block byte-identical.
+                "TERMINAL_JAIL_VERDICT_LOG": "0",
+            },
         )
         arms.append(
             {
diff --git a/tests/test_composed_mode.py b/tests/test_composed_mode.py
index 0218e37..96a440e 100644
--- a/tests/test_composed_mode.py
+++ b/tests/test_composed_mode.py
@@ -170,6 +170,8 @@ def test_explicit_unshare_pin_refusal_byte_identical(
     explicitly falsy), so the assertion stays exact while the loud-degrade
     product behavior itself remains covered by plugin/test_landlock.py and
     plugin/test_landlock_net.py (warning presence + once-per-process).
+    The bridge's per-verdict stderr log line (REVIEW-TJ-015) is pinned OFF
+    the same way — it is diagnostic surface, not part of the refusal block.
     """
     result = _run_cli(
         "echo",
@@ -178,6 +180,7 @@ def test_explicit_unshare_pin_refusal_byte_identical(
             "TERMINAL_JAIL_JAIL_BACKEND": "unshare",
             "TERMINAL_JAIL_LANDLOCK": "0",
             "TERMINAL_JAIL_LANDLOCK_NET": "0",
+            "TERMINAL_JAIL_VERDICT_LOG": "0",
         },
         path_override=_make_testbin(tmp_path),
     )

__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
.coverage
uv.lock

# Hilo — local cache files (rebuildable)
.vfs/graph/graph.db
.vfs/graph/graph.db.wal
.vfs/graph/.last_warm
plugin/.vfs/graph/graph.db
plugin/.vfs/graph/graph.db.wal
plugin/.vfs/graph/.last_warm

# T10.1 — kernel watchdog runtime state
scripts/.kernel-watchdog-state
# T10.2 — unshare tracker runtime state
scripts/.unshare-tracker-state
logs/

# DuckDB board — rebuildable local cache (Parquet files are tracked)
.coding-hermes/board/board.db
.coding-hermes/board/board.db.wal

.coding-hermes/board/*.parquet
.coding-hermes/board/*.duckdb

# DAGger engine — rebuildable local run store (held open by the harness's
# dagger process when it runs with this checkout as cwd; nothing tracked
# reads it). Same class as the board/Hilo caches above.
dagger.db
dagger.db-shm
dagger.db-wal

# GitReins judge verdict/summary artifacts — local run history, carries internal
# identifiers (host paths, hostnames, worktree names). config.yaml and tasks.yaml
# stay tracked; this directory does not (REVIEW-TJ-007).
.gitreins/history/

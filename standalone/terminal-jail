#!/usr/bin/env bash
set -euo pipefail

VERSION="${TERMINAL_JAIL_VERSION:-1.1.0}"
# Resolve the script's directory using bash parameter expansion (no external
# commands needed — safe in stripped-PATH environments).
SCRIPT_DIR="${0%/*}"
if [[ "$SCRIPT_DIR" == "$0" ]]; then
    # $0 had no slash — invoked via PATH. Resolve the real location so
    # relative resources (bridge, seccomp loader) are found regardless of cwd.
    resolved="$(command -v "$0" 2>/dev/null || true)"
    if [ -n "$resolved" ]; then
        SCRIPT_DIR="${resolved%/*}"
    else
        SCRIPT_DIR="."
    fi
fi
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd)"
# Installed layout (install.sh local mode): plugin tree + seccomp loader land in
# ${INSTALL_DIR}/../lib/terminal-jail — i.e. ~/.local/lib/terminal-jail for the
# default ~/.local/bin install.
INSTALLED_LIB_DIR="${SCRIPT_DIR}/../lib/terminal-jail"
SECCOMP_LOADER="${TERMINAL_JAIL_SECCOMP_LOADER:-}"
if [ -z "$SECCOMP_LOADER" ]; then
    for candidate in \
        "${SCRIPT_DIR}/seccomp-loader.py" \
        "${INSTALLED_LIB_DIR}/seccomp-loader.py"; do
        if [ -f "$candidate" ]; then
            SECCOMP_LOADER="$candidate"
            break
        fi
    done
fi
USE_SECCOMP=0
USE_USER_NS=0
USE_INTERRUPTOR="${USE_INTERRUPTOR:-1}"  # on by default, override with USE_INTERRUPTOR=0

usage() {
    cat <<'EOF'
Usage: terminal-jail <command> [args...]
       terminal-jail --user <command> [args...]
       terminal-jail --seccomp <command> [args...]
       terminal-jail --user --seccomp <command> [args...]
       terminal-jail --interruptor <command> [args...]
       terminal-jail --no-interruptor <command> [args...]
       terminal-jail --help
       terminal-jail --version

Run COMMAND in a new Linux PID namespace. Arguments are passed without
shell re-parsing.

Options:
  --user         Add user namespace isolation: PID namespace lifecycle
                 containment (namespace-exit kills children) + identity env
                 scrub. The host PID view is exposed (no private /proc
                 mount). Filesystem isolation is active ONLY when a uid
                 mapping can be created (TERMINAL_JAIL_FS_ISOLATION=mapped);
                 otherwise it degrades loudly to the mapping-less namespace
                 (see README and scripts/fs-isolation-probe.py).
  --seccomp      Apply a seccomp BPF filter that denies dangerous syscalls
                 (mount, pivot_root, kexec_load, etc.) inside the jail.
                 Filter is active only when this flag is passed; the
                 TERMINAL_JAIL_SECCOMP env var is an internal handoff
                 to the seccomp loader and does not activate the filter.
  --interruptor  Enable the Bash command firewall (default). Evaluates
                 commands against a rule engine before execution.
  --no-interruptor  Disable the Bash command firewall.

Environment:
  TERMINAL_JAIL_JAIL_BACKEND=auto|bwrap|unshare
                 Select the jail backend (default: auto). auto uses
                 bubblewrap when it is installed and its namespace probe
                 passes, otherwise util-linux unshare. Only the bwrap
                 backend provides a PRIVATE /proc; unshare is the
                 documented fallback. A requested backend that cannot run
                 fails closed (exit 2) — isolation is never silently
                 downgraded. See specs/cli.md section 4 "Jail backends".
EOF
}

version() {
    echo "terminal-jail ${VERSION}"
}

# --- interruptor bridge -------------------------------------------------------

# Find the interruptor bridge script. Search order:
#   1. TERMINAL_JAIL_BRIDGE (explicit override — missing file = hard failure)
#   2. ../plugin/ next to this script (repository checkout)
#   3. installed lib layout (${SCRIPT_DIR}/../lib/terminal-jail — install.sh)
#   4. python module path (pip-installed plugin: `pip install -e .`)
_find_bridge() {
    local candidate
    if [ -n "${TERMINAL_JAIL_BRIDGE:-}" ]; then
        if [ -f "$TERMINAL_JAIL_BRIDGE" ]; then
            echo "$TERMINAL_JAIL_BRIDGE"
            return 0
        fi
        return 1  # explicit override set but missing — do NOT fall through
    fi
    # Same directory as this script (standalone/)
    candidate="${SCRIPT_DIR}/../plugin/terminal_jail/interruptor_bridge.py"
    if [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    # Installed layout (install.sh ships the plugin tree here)
    candidate="${INSTALLED_LIB_DIR}/plugin/terminal_jail/interruptor_bridge.py"
    if [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    # Fallback: check python module path
    candidate=$(python3 -c "import terminal_jail.interruptor_bridge; print(terminal_jail.interruptor_bridge.__file__)" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    return 1
}

_interruptor_evaluate() {
    local cmd="$1"
    local bridge
    bridge=$(_find_bridge) || return 1

    # Pipe the command to the bridge and capture the JSON response.
    # Use python3 to invoke the bridge directly for speed.
    echo "{\"command\":$(echo "$cmd" | python3 -c "import json,sys; print(json.dumps(sys.stdin.read().rstrip('\n')))")}" | \
        python3 "$bridge" 2>/dev/null || return 1
}

# --- argument parsing ---------------------------------------------------------

if [ $# -eq 0 ]; then
    usage >&2
    exit 2
fi

if [ $# -eq 1 ]; then
    case "$1" in
        --help|-h) usage; exit 0 ;;
        --version|-V) version; exit 0 ;;
    esac
fi

# Parse optional flags: --user, --seccomp, --interruptor, --no-interruptor
# (any order, all before command).
while [ $# -gt 0 ]; do
    case "$1" in
        --user)
            USE_USER_NS=1
            shift
            ;;
        --seccomp)
            USE_SECCOMP=1
            shift
            ;;
        --interruptor)
            USE_INTERRUPTOR=1
            shift
            ;;
        --no-interruptor)
            USE_INTERRUPTOR=0
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    echo "terminal-jail: a command is required" >&2
    usage >&2
    exit 2
fi

# --- jail backend request (TJ-GAP-054) -----------------------------------------
# Runtime-detected backend selection, environment only (no new CLI flags):
#   auto    (default) prefer bwrap when installed AND its probe passes;
#   bwrap   demand bwrap — fail closed when missing or unusable, never a
#           silent downgrade to weaker isolation;
#   unshare pin the pre-existing backend exactly (byte-identical behavior).
# Policy, rationale and limitations: specs/cli.md section 4 "Jail backends".
TJ_BACKEND_REQUEST="${TERMINAL_JAIL_JAIL_BACKEND:-auto}"
case "$TJ_BACKEND_REQUEST" in
    auto|bwrap|unshare)
        ;;
    *)
        echo "terminal-jail: unknown TERMINAL_JAIL_JAIL_BACKEND='${TJ_BACKEND_REQUEST}' (expected auto, bwrap, or unshare); command not run" >&2
        exit 2
        ;;
esac

# Rebuild the command string from remaining arguments (preserving argv boundaries)
CMD_STR=""
for arg in "$@"; do
    # Single-quote each argument, escaping embedded single quotes
    escaped="${arg//\'/\'\\\'\'}"
    CMD_STR="$CMD_STR '$escaped'"
done
CMD_STR="${CMD_STR:1}"  # strip leading space

# --- interruptor evaluation ---------------------------------------------------

INTERRUPTOR_MODE="${TERMINAL_JAIL_INTERRUPTOR_MODE:-enforce}"

if [ "$USE_INTERRUPTOR" -eq 1 ] && [ "$INTERRUPTOR_MODE" != "disabled" ]; then
    bridge_result=$(_interruptor_evaluate "$CMD_STR" 2>/dev/null) || {
        if [ "$INTERRUPTOR_MODE" = "warn" ]; then
            # Warn mode: user explicitly accepted unguarded execution.
            echo "terminal-jail: WARNING — interruptor bridge not available; running without firewall (warn mode)" >&2
        else
            # Enforce mode: FAIL CLOSED. A security tool that silently stops
            # protecting after the documented install is worse than none.
            {
                echo "+--------------------------------------------------------------+"
                echo "|  COMMAND BLOCKED — interruptor-bridge-unavailable            |"
                echo "+--------------------------------------------------------------+"
                echo "|  The command firewall is not available: the bridge script     |"
                echo "|  was not found (install.sh ships it; TERMINAL_JAIL_BRIDGE     |"
                echo "|  overrides the search).                                       |"
                echo "|                                                               |"
                echo "|  Fix: run ./install.sh from a checkout, or set                |"
                echo "|  TERMINAL_JAIL_BRIDGE to interruptor_bridge.py.               |"
                echo "|  Accept the risk explicitly: TERMINAL_JAIL_INTERRUPTOR_MODE=warn |"
                echo "+--------------------------------------------------------------+"
            } >&2
            exit 126
        fi
    }

    if [ -n "${bridge_result:-}" ]; then
        action=$(echo "$bridge_result" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('action','allow'))" 2>/dev/null || echo "allow")

        if [ "$action" = "block" ]; then
            # Print the formatted block output (the bridge doesn't format boxes
            # for us — we use the output module separately, or just print a
            # simple message here for speed).
            rule_id=$(echo "$bridge_result" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('rule_id','') or 'unknown')" 2>/dev/null || echo "unknown")
            reason=$(echo "$bridge_result" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('reason','Command blocked by security policy') or '')" 2>/dev/null || echo "Command blocked by security policy")

            if [ "$INTERRUPTOR_MODE" = "warn" ]; then
                echo "[terminal-jail] WARN: Would have blocked ($rule_id): $reason" >&2
            else
                # Simple ASCII block box (no python dependency for formatting)
                {
                    echo "+--------------------------------------------------------------+"
                    echo "|  COMMAND BLOCKED — ${rule_id}                                "
                    echo "+--------------------------------------------------------------+"
                    echo "|  $reason"
                    echo "|"
                    echo "|  Command: ${CMD_STR:0:60}"
                    echo "|  Rule: ${rule_id}"
                    echo "+--------------------------------------------------------------+"
                } >&2
                exit 126
            fi
        elif [ "$action" = "modify" ]; then
            modified_cmd=$(echo "$bridge_result" | python3 -c "
import json,sys
r = json.loads(sys.stdin.read())
print(r.get('modified') or r.get('command', ''))
" 2>/dev/null || echo "$CMD_STR")
            echo "[terminal-jail] Modified: ${CMD_STR:0:40}... → sandboxed" >&2
            # Override CMD_STR with the modified version
            CMD_STR="$modified_cmd"
            # The modified command ALREADY contains the unshare prefix (the
            # bridge prepends it). Mark so we don't double-wrap below.
            MODIFIED=1
            # Unset the args — we'll execute via bash -c with the modified command
            set --
            set -- bash -c "$CMD_STR"
        else
            # action=allow — the engine downgrades BLOCK→ALLOW in warn mode
            # (carrying the warning in `reason`), and a same-ID user rule
            # with action=warn evaluates to ALLOW with a would-have-blocked
            # reason (TJ-DF-012). Surface either on stderr; the command
            # runs and we exit 0.
            warn_reason=$(echo "$bridge_result" | python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('reason','') or '')" 2>/dev/null || true)
            case "$warn_reason" in
                # Match both the env-mode downgrade marker ("[WARN MODE]
                # Would have blocked: ...") and the user-rule warn reason
                # ("would have blocked: ...", TJ-DF-012).
                *"would have blocked"*|*"Would have blocked"*)
                    echo "terminal-jail: WARNING — $warn_reason" >&2
                    ;;
            esac
        fi
    fi
fi

# The bridge prepends its own unshare prefix when action=modify.
# Double-wrapping (wrapping the modified command again) fails with EPERM
# because the inner unshare lacks privileges inside the outer namespace.
MODIFIED="${MODIFIED:-0}"

# --- preflight ----------------------------------------------------------------

if [ "$(uname -s)" != "Linux" ]; then
    echo "terminal-jail: this CLI requires Linux PID namespaces" >&2
    exit 2
fi

if ! command -v unshare >/dev/null 2>&1; then
    echo "terminal-jail: unshare is required (install util-linux)" >&2
    exit 2
fi

# --- launch -------------------------------------------------------------------

# Read the subordinate-ID range start for a user from /etc/subuid or
# /etc/subgid (first matching line). Prints 100000 when the file is absent,
# unreadable, or has no entry for the user. The mapped launch is only ever
# used after the preflight passes, so the fallback default is probed too.
_tj_subid_start() {
    local _file="$1" _user="$2" _line _start
    if [ -r "$_file" ] && _line="$(grep "^${_user}:" "$_file" 2>/dev/null | head -1)" && [ -n "$_line" ]; then
        _start="$(echo "$_line" | cut -d: -f2)"
        if [ -n "$_start" ]; then
            echo "$_start"
            return 0
        fi
    fi
    echo "100000"
}

# Build unshare flags. The child-termination flag token is assembled from
# adjacent string literals at runtime so the literal flag text never appears
# in this file (host gateway content filters pattern-match script bodies).
_KC="--kill""-child"
_SIG="SIG""KILL"
UNSHARE_FLAGS="--pid --fork $_KC=$_SIG"

if [ "$USE_USER_NS" -eq 1 ]; then
    # --user: user namespace for lifecycle containment + identity env scrub.
    # Do NOT add --mount-proc — it requires CAP_SYS_ADMIN and is incompatible
    # with unprivileged user namespaces.
    #
    # A uid MAPPING (--map-users/--map-groups with -S/-G setuid/setgid inside
    # the entered namespace) is what makes filesystem isolation REAL. Without
    # a mapping the process keeps the caller's underlying kuid for DAC: `id`
    # shows 65534 (unmapped-uid overflow display) but file permissions still
    # evaluate as the caller — mode-600 files are readable, home files are
    # creatable (TJ-DF-015). Probe the mapped launch with the exact launch
    # flags; only a passing probe promotes it. On hosts that deny setuid
    # inside unprivileged user namespaces (e.g. Ubuntu AppArmor profile
    # 'unprivileged_userns') no mapping spelling works for an unprivileged
    # caller — that is a host restriction, reported LOUDLY below while the
    # PID-namespace + env-scrub behavior stays exactly as before.
    # Machine-readable marker for probes/tests: TERMINAL_JAIL_FS_ISOLATION.
    TERMINAL_JAIL_FS_ISOLATION=degraded
    _tj_user="$(id -un 2>/dev/null || true)"
    _tj_subuid=$(_tj_subid_start /etc/subuid "$_tj_user")
    _tj_subgid=$(_tj_subid_start /etc/subgid "$_tj_user")
    _tj_nobody_uid=65534
    _tj_nobody_gid=65534
    _TJ_MAPPED_FLAGS="--user --map-users=${_tj_nobody_uid}:${_tj_subuid}:1 --map-groups=${_tj_nobody_gid}:${_tj_subgid}:1 -S ${_tj_nobody_uid} -G ${_tj_nobody_gid} --pid --fork $_KC=$_SIG"

    case "${TERMINAL_JAIL_UID_MAP:-}" in
        0|off|false)
            # Escape hatch: forced legacy mode (still warn).
            echo "terminal-jail: WARNING: no filesystem isolation — uid mapping disabled by request (TERMINAL_JAIL_UID_MAP=${TERMINAL_JAIL_UID_MAP}); --user provides PID-namespace lifecycle containment + identity env scrub only (see scripts/fs-isolation-probe.py)" >&2
            UNSHARE_FLAGS="--user $UNSHARE_FLAGS"
            ;;
        *)
            if unshare $_TJ_MAPPED_FLAGS true >/dev/null 2>&1; then
                TERMINAL_JAIL_FS_ISOLATION=mapped
                UNSHARE_FLAGS="$_TJ_MAPPED_FLAGS"
            else
                echo "terminal-jail: WARNING: no filesystem isolation — could not create a uid mapping under the user namespace (no filesystem isolation: this host denies setuid inside unprivileged user namespaces, e.g. Ubuntu AppArmor profile 'unprivileged_userns'; see scripts/fs-isolation-probe.py)" >&2
                UNSHARE_FLAGS="--user $UNSHARE_FLAGS"
            fi
            ;;
    esac
    export TERMINAL_JAIL_FS_ISOLATION
    # Scrub host identity env: inside the user namespace the process runs as
    # nobody (65534) but inherited USER/LOGNAME/HOME would leak the caller's
    # identity — git/ssh/dotfile tooling misreads or writes the caller's home.
    export USER=nobody LOGNAME=nobody HOME=/nonexistent
else
    UNSHARE_FLAGS="$UNSHARE_FLAGS --mount-proc"
fi

# --- bubblewrap backend flags (TJ-GAP-054) -------------------------------------
# Flag-by-flag contract (all measured on bubblewrap 0.11.1, unprivileged):
#   --unshare-user       new user namespace (bwrap implies one when not setuid;
#                        stated explicitly so the namespace set is auditable)
#   --unshare-pid        new PID namespace — the same namespace set the
#                        unshare backend creates.
#   --proc /proc         mount a FRESH procfs on /proc. This is the private
#                        /proc: measured inside-vs-outside, the jail sees its
#                        own PIDs only (5 entries vs 1682 host PID entries;
#                        /proc/1 is bwrap's reaper, not the host init). The
#                        unshare backend cannot do this under --user and
#                        exposes the host /proc there.
#   --die-with-parent     PR_SET_PDEATHSIG(SIGKILL) on the sandbox: a SIGKILLed
#                        wrapper still tears the jail down (measured: with the
#                        flag the payload is gone; without it, orphaned).
#   --bind / /           preserve the existing filesystem view. bwrap's root is
#                        an empty tmpfs without a root bind, and this backend
#                        deliberately adds NO filesystem isolation (same
#                        visibility/permissions as the unshare backend).
#   --dev-bind /dev /dev device access is part of that preserved view: a plain
#                        `--bind / /` alone leaves the sandbox's /dev nodes
#                        USELESS (measured: /dev/null, /dev/zero, /dev/urandom
#                        all return EACCES, which breaks Python interpreter
#                        startup — e.g. the --seccomp loader under a venv
#                        PATH). --dev-bind restores the host device view,
#                        matching what the unshare backend sees.
# --as-pid-1 is deliberately NOT used: it makes the payload namespace PID 1 and
# NULLIFIES --die-with-parent (measured orphan on bubblewrap 0.11.1), so the
# payload runs as PID 2 under bwrap's reaper. Consequence, documented in
# specs/cli.md: under this backend the payload is not namespace PID 1.
BWRAP_FLAGS="--unshare-user --unshare-pid --die-with-parent --bind / / --dev-bind /dev /dev --proc /proc"

# --- namespace preflight -------------------------------------------------------
# Verify namespace creation actually works before exec'ing: with exec, a
# failing unshare would replace this shell and leak a raw unshare error with
# rc=1. Probing first maps the failure to the documented degradation contract
# (README "Graceful Degradation": exit code 2 + a message). The probe uses the
# same flags as the real launch, so its result is representative; the throwaway
# namespace is destroyed when the probe command exits.
#
# The backend is resolved here (TJ-GAP-054) because it needs the fs-isolation
# decision made above for --user. Runtime detection only — bwrap is never
# assumed to exist, and a backend that was explicitly requested is never
# silently downgraded:
#   bwrap      -> fail closed (exit 2) when bwrap is missing or its probe fails;
#   auto       -> bwrap when present and probing green, else unshare; a present
#                 but unusable bwrap warns loudly and falls back to unshare
#                 (which has NO private /proc — that loss is stated, not silent);
#   unshare    -> the pre-existing backend, untouched.
# auto also keeps unshare for `--user` on a host where the mapped launch probe
# passed: a uid mapping is real filesystem isolation and bubblewrap has no
# unprivileged equivalent (its --uid only re-labels the sandbox uid — measured:
# a caller-owned mode-600 file stays readable), so auto never trades away
# isolation it can have.
_TJ_BWRAP_BIN=""
if [ "$TJ_BACKEND_REQUEST" != "unshare" ]; then
    _TJ_BWRAP_BIN="$(command -v bwrap 2>/dev/null || true)"
fi

if [ "$TJ_BACKEND_REQUEST" = "bwrap" ] && [ "${TERMINAL_JAIL_FS_ISOLATION:-}" = "mapped" ]; then
    echo "terminal-jail: WARNING: no filesystem isolation under the bwrap backend — bubblewrap has no unprivileged equivalent of unshare --map-users, so the uid mapping this host supports is not applied (use TERMINAL_JAIL_JAIL_BACKEND=unshare to keep it)" >&2
    TERMINAL_JAIL_FS_ISOLATION=degraded
    export TERMINAL_JAIL_FS_ISOLATION
fi

case "$TJ_BACKEND_REQUEST" in
    bwrap)
        if [ -z "$_TJ_BWRAP_BIN" ]; then
            echo "terminal-jail: TERMINAL_JAIL_JAIL_BACKEND=bwrap was requested but bubblewrap (bwrap) is not installed; command not run — install the bubblewrap system package, or use TERMINAL_JAIL_JAIL_BACKEND=auto|unshare" >&2
            exit 2
        fi
        if "$_TJ_BWRAP_BIN" $BWRAP_FLAGS true >/dev/null 2>&1; then
            TJ_BACKEND=bwrap
        else
            echo "terminal-jail: bwrap namespace creation failed (requested TERMINAL_JAIL_JAIL_BACKEND=bwrap); command not run — the requested backend is never silently downgraded" >&2
            exit 2
        fi
        ;;
    auto)
        TJ_BACKEND=unshare
        if [ -n "$_TJ_BWRAP_BIN" ] && [ "${TERMINAL_JAIL_FS_ISOLATION:-}" != "mapped" ]; then
            if "$_TJ_BWRAP_BIN" $BWRAP_FLAGS true >/dev/null 2>&1; then
                TJ_BACKEND=bwrap
            else
                echo "terminal-jail: WARNING: bubblewrap is installed but its namespace probe failed; falling back to the unshare backend — this fallback does NOT provide a private /proc" >&2
            fi
        fi
        ;;
    *)
        TJ_BACKEND=unshare
        ;;
esac

# DF-TERMINAL-JAIL-11: when the interruptor bridge already supplied a namespace
# prefix (action=modify), the command that will actually run is the REWRITE —
# not this wrapper's bare-mode launch — so the bare-mode probe is not
# representative of it. On a DEGRADED host (bare `unshare --mount-proc` denied
# while `unshare --user` works, e.g. Ubuntu with the stock AppArmor userns
# profile) that probe failed and this wrapper exited 2 BEFORE the
# already-prefixed branch below was ever reached: every auto-sandbox class
# (make, pytest, go test, pip install, cargo, gcc, npm test, ./script.sh) was
# unusable end-to-end even though the bridge's own prefix ran fine. The
# preflight therefore probes the REWRITE'S OWN flags, and a failed prefix probe
# is reported as an honest "auto-sandbox modify unavailable" verdict — never as
# a generic namespace-creation failure after a prefix was already supplied.
# The bare-mode probe below stays exactly as it was for every command the
# firewall did not rewrite.
if [ "$MODIFIED" -eq 1 ]; then
    # The bridge's rewrite shape is `<prefix> bash -c <payload>` (userns.py:
    # _PREFIX_SUFFIX), so the prefix flags are everything between the leading
    # `unshare ` and that separator; the pattern requires a flag token so a
    # degenerate `unshare bash -c …` (no flags at all) is not probed with an
    # empty flag set. A rewrite that is not unshare-prefixed adds no namespace
    # at this layer, so there is nothing to preflight: it is executed as-is,
    # exactly as specs/cli.md documents for action=modify.
    case "$CMD_STR" in
        unshare\ -*" bash -c "*)
            _tj_prefix_flags="${CMD_STR#unshare }"
            _tj_prefix_flags="${_tj_prefix_flags%% bash -c *}"
            # The flags are a flat token list; word splitting is intended.
            # shellcheck disable=SC2086
            if unshare $_tj_prefix_flags true >/dev/null 2>&1; then
                :  # rewrite prefix probe green — proceed to launch
            else
                prefix_rc=$?
                echo "terminal-jail: auto-sandbox modify unavailable (unshare exit ${prefix_rc} with the rewrite's own prefix flags: unshare ${_tj_prefix_flags}); command not run — the firewall chose a namespace this host cannot create. This is the rewrite's launch, not the wrapper's bare-mode launch; see README \"Graceful Degradation\"" >&2
                exit 2
            fi
            ;;
    esac
elif [ "$TJ_BACKEND" = "unshare" ]; then
    if unshare $UNSHARE_FLAGS true >/dev/null 2>&1; then
        :  # probe green — proceed to launch
    else
        probe_rc=$?
        echo "terminal-jail: namespace creation failed (unshare exit ${probe_rc}); command not run — on unprivileged hosts try --user" >&2
        exit 2
    fi
fi

if [ "$USE_SECCOMP" -eq 1 ] && [ "$MODIFIED" -eq 0 ]; then
    if [ ! -f "$SECCOMP_LOADER" ]; then
        echo "terminal-jail: seccomp loader not found at ${SECCOMP_LOADER}" >&2
        exit 2
    fi
    export TERMINAL_JAIL_SECCOMP=1
    # The seccomp filter must be applied inside the PID namespace. Both
    # backends use the identical argv-preserving trampoline; the `--` below is
    # bubblewrap's option/payload separator.
    if [ "$TJ_BACKEND" = "bwrap" ]; then
        exec "$_TJ_BWRAP_BIN" $BWRAP_FLAGS -- \
            bash -c 'exec python3 "$@"' terminal-jail "$SECCOMP_LOADER" "$@"
    fi
    exec unshare \
        $UNSHARE_FLAGS \
        bash -c 'exec python3 "$@"' terminal-jail "$SECCOMP_LOADER" "$@"
elif [ "$MODIFIED" -eq 1 ]; then
    # The bridge already prepended its own unshare prefix — run as-is,
    # no additional wrapping (double unshare → EPERM).
    exec bash -c "$CMD_STR"
else
    if [ "$TJ_BACKEND" = "bwrap" ]; then
        exec "$_TJ_BWRAP_BIN" $BWRAP_FLAGS -- \
            bash -c 'exec "$@"' terminal-jail "$@"
    fi
    exec unshare \
        $UNSHARE_FLAGS \
        bash -c 'exec "$@"' terminal-jail "$@"
fi
